/*-------------
Write a program that asks the user for a number n, then uses a while loop to print the square of all numbers from 1 to n. 
Sample Input: 
Enter n: 5 
Sample Output: 
1 4 9 16 25 
-------*/

int main () {
    
    for (int i = 1; i <= 25; i++) {// i++ for increment , i-- for decrement
        cout << i << endl;
        for (int s = 5; s = i; i++)
        cout << i + 1 << endl;
    }
}
