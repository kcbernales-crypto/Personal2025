#include <iostream>
#include <string>
using namespace std;


string convert_num_to_string(int num) {
    // check if 1 - 9
    string str = "";
    switch(num) {
        case 1:
            str = "one";
            break;
        case 2:
            str = "two";
            break;
        case 3:
            str = "three";
            break;
        case 4:
            str = "four";
            break;
        case 5:
            str = "five";
            break;
        case 6:
            str = "six";
            break;
        case 7:
            str = "seven";
            break;
        case 8:
            str = "eight";
            break;
        case 9:
            str = "nine";
            break;
        default:
            str = "";
    }
    
    
    return str;
}

int main() {
    // Complete the code.
    int a, b;
    cin >> a;
    cin >> b;
    
    
    for(int n = a; n <= b; n++) {
        if (1 <= n && n <= 9) {
            string strvalue = convert_num_to_string(n);
            cout << strvalue << endl;
        } 
        
        else if(n > 9) {
            if(n % 2 == 0) {
                cout << "even" << endl;
            } else {
                cout << "odd" << endl;
            }
        }
        
    }
}

