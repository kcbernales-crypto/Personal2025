#include <iostream>
using namespace std;

int main () {
    
    for (int l = 1; l <= 100; l++) {
        if (l % 3 == 0) 
            cout << "Fizz" << endl;
        else if (l % 5 == 0)
            cout << "Buzz" << endl;
        else if (l % 5 == 0 && l % 3 == 0)
            cout << "Fizzbuzz" << endl;
        else
            cout << l << endl;
        
    }
}
